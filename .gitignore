node_modules/
**/node_modules/
.pnp
.pnp.js

# Next.js Build & Cache
.next/
**/.next/
out/
build/
dist/

# Next.js / Node environment variables
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Video files & heavy media (preserve folders with .gitkeep)
*.mov
*.mp4
*.mkv
*.webm
*.avi
*.m4v
!**/.gitkeep

# Video generation outputs & temporary renders
apps/web/public/temp_render/
apps/web/public/generated_videos/*
!apps/web/public/generated_videos/.gitkeep
**/temp_render/

# Archivos importados desde el "Editor de video" (imagen/video propios del usuario).
# Viven en assets/uploads (no en public/): ver getAssetsUploadsDir() en
# lib/contentLibrary.ts — public/ no sirve archivos escritos en runtime en el
# build "standalone" de Next.js.
assets/uploads/

# Go engine runtime data & compiled binaries
services/engine/bin/
services/engine/data/videos/
**/cmd/server/data/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build artifacts
*.tsbuildinfo

# Claude Code skills lockfile (tooling local)
skills-lock.json

# Other
.agents
.doc
