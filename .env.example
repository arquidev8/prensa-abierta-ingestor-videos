# =============================================================================
# Prensa Abierta - Ingestor de Videos · Variables de entorno
# =============================================================================
# Copia este archivo a `.env` (raíz del repo) y complétalo con tus credenciales.
# `.env` está en .gitignore; NUNCA lo subas al repositorio.
#
# Este `.env` de raíz lo consume `docker-compose.yml` (interpolación ${VAR} y
# variables del servicio `web`). Para correr `apps/web` en local sin Docker,
# usa además `apps/web/.env.local` (ver `apps/web/.env.example`).
# =============================================================================


# -----------------------------------------------------------------------------
# IA · Redacción editorial (lib/ollama.ts)
# -----------------------------------------------------------------------------
# API remota compatible con OpenAI (Ollama Cloud / SiliconFlow). NO es un
# servidor Ollama local. Si la llamada falla, el pipeline cae automáticamente
# al motor autónomo local (lib/rewriter.ts) y sigue funcionando sin IA.

# Base URL del endpoint (se le agrega /chat/completions).
#   Ollama Cloud:  https://ollama.com/v1   (OJO: ollama.com, NO api.ollama.com)
#   SiliconFlow:   https://api.siliconflow.cn/v1
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# Bearer token del proveedor. Si se deja vacío, se usa el motor autónomo.
# Ollama Cloud: se crea en https://ollama.com/settings/keys (cuenta paga).
OLLAMA_CLOUD_API_KEY=

# Modelo. La UI ofrece: glm-5.2 | minimax-m3 | qwen3.5:397b
# Deben ser tags válidos del proveedor (ver https://ollama.com/search?c=cloud).
OLLAMA_MODEL=glm-5.2


# -----------------------------------------------------------------------------
# WordPress · Publicación (lib/wordpress.ts)
# -----------------------------------------------------------------------------
# Por seguridad, el modo DRY RUN está ACTIVO por defecto: no publica nada real
# a menos que WP_DRY_RUN=false Y haya Application Password.
WP_DRY_RUN=true

WP_BASE_URL=https://prensaabierta.pr
WP_USERNAME=
# Application Password de WordPress (formato: "xxxx xxxx xxxx xxxx").
WP_APPLICATION_PASSWORD=


# -----------------------------------------------------------------------------
# Pexels · Banco de video/imágenes (lib/pexels.ts)
# -----------------------------------------------------------------------------
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Locución de los videos (ElevenLabs text-to-speech) ───────────────────────
# El Engine convierte "categoría + titular + arranque de la nota" en voz y la mezcla al .mp4.
# Sin ELEVENLABS_API_KEY los videos se generan mudos (no falla nada). Key: elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcionales (defaults: voz Daniel "authoritative", modelo eleven_multilingual_v2, velocidad 1.0)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_SPEED=
# Perfil de la voz (voice_settings de ElevenLabs), todos 0.0-1.0. Defaults del perfil
# "News/Professional": estabilidad 0.8 (consistente), similitud 0.6, estilo 0.0 (sin exagerar).
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=


# -----------------------------------------------------------------------------
# Wiring de red entre servicios (usado por docker-compose)
# -----------------------------------------------------------------------------
# URL del Go Engine incrustada en el bundle del navegador (build-time).
# Debe ser la URL publicada en el host: el servicio `engine` publica su puerto
# como "8081:8080" (host:contenedor) en docker-compose.yml, así que esto debe
# ser 8081, no 8080 (ese es el puerto interno del contenedor).
NEXT_PUBLIC_ENGINE_URL=http://localhost:8081

# URL del Go Engine desde el código de servidor de Next (runtime).
# En Docker: DNS interno del compose.
ENGINE_INTERNAL_URL=http://engine:8080

# URL por la que el Go Engine alcanza al servicio `web` para descargar los
# clips (clip_urls). NO puede ser localhost dentro de Docker.
WEB_INTERNAL_URL=http://web:3000


# -----------------------------------------------------------------------------
# Go Engine · Render de video (services/engine)
# -----------------------------------------------------------------------------
PORT=8080
DATA_DIR=/app/data
ASSETS_DIR=/app/assets

# Nº de renders de FFmpeg concurrentes (worker pool).
VIDEO_RENDER_WORKERS=2

# Matcher "misma noticia en otros medios" (pkg/matcher): compara solo entre las
# 5 fuentes RSS ya scrapeadas (pkg/scraper/sources.go), sin IA ni servicios
# externos. RELATED_NEWS_SIMILARITY_THRESHOLD es el score 0..1 mínimo para
# enlazar dos noticias (default calibrado con pares sintéticos, ver
# matcher.DefaultConfig — se espera afinarlo con datos reales). RELATED_NEWS_WINDOW_HOURS
# acota la comparación a noticias publicadas dentro de esa diferencia horaria.
RELATED_NEWS_SIMILARITY_THRESHOLD=0.12
RELATED_NEWS_WINDOW_HOURS=48

# Ruta al binario de FFmpeg. Vacío = se busca en el PATH.
FFMPEG_PATH=

# URLs públicas (Cloudinary) del logo y el banner "Descarga la App GRATIS",
# quemados por el Go Engine sobre cada video. Opcionales: si se dejan vacías,
# el Engine usa el archivo local en assets/logos/ como hasta ahora. Se
# obtienen corriendo `npm run migrate:cloudinary` en apps/web (ver
# apps/web/scripts/migrate-assets-to-cloudinary.mjs).
LOGO_URL=
PROMO_IMAGE_URL=


# -----------------------------------------------------------------------------
# Cloudinary · Migración del banco de medios (assets/contenido + assets/logos)
# -----------------------------------------------------------------------------
# Solo las usa el script de migración (`npm run migrate:cloudinary` en
# apps/web), corrido a mano desde tu máquina — NUNCA se leen en runtime por
# `web` ni por `engine`, así que no hace falta ponerlas en producción.
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Base de datos de usuarios y roles (PostgreSQL) ---------------------------
# El Engine guarda usuarios, roles y el contador diario de videos en PostgreSQL y aplica solo las
# migraciones al arrancar. Con `docker compose` se levanta un servicio `postgres` local.
# Obligatoria: sin contraseña compose se niega a arrancar. Usa algo sin caracteres especiales
# (ej. `openssl rand -hex 24`) porque va dentro de la URL de conexión.
POSTGRES_PASSWORD=
POSTGRES_USER=prensa
POSTGRES_DB=prensa_abierta
# Puerto en tu máquina (solo loopback) para conectarte con psql / un cliente gráfico.
POSTGRES_HOST_PORT=5433
# Para usar una base gestionada en vez del servicio local, define la URL completa (gana sobre lo anterior):
# DATABASE_URL=postgres://usuario:clave@host:5432/base?sslmode=require
# Zona horaria que define cuándo empieza el "día" del límite diario de videos.
USAGE_TIMEZONE=America/Puerto_Rico

# --- Usuarios / login (Go Engine) ------------------------------------------------
# Superadmin inicial: solo se crea si la tabla users está vacía (y no hay un users.json anterior que
# importar). Si dejas la contraseña vacía, el Engine genera una y la imprime una sola vez en `docker logs`.
SEED_SUPERADMIN_EMAIL=admin@prensaabierta.com
SEED_SUPERADMIN_PASSWORD=
