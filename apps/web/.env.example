# =============================================================================
# apps/web · Variables de entorno para desarrollo local (sin Docker)
# =============================================================================
# Copia a `apps/web/.env.local` (Next.js lo carga automáticamente).
# Para el despliegue con Docker usa el `.env` de la raíz (ver ../../.env.example).
# =============================================================================

# --- IA (lib/ollama.ts) -------------------------------------------------------
# Vacío => usa el motor autónomo local (lib/rewriter.ts), sin llamadas externas.
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=
OLLAMA_MODEL=glm-5.2

# --- WordPress (lib/wordpress.ts) -------------------------------------------
# DRY RUN activo por defecto: no publica nada real.
WP_DRY_RUN=true
WP_BASE_URL=https://prensaabierta.pr
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# --- Pexels (lib/pexels.ts) ------------------------------------------------
PEXELS_API_KEY=

# --- Go Engine local ------------------------------------------------------
# Al correr el engine con `go run ./cmd/server` su puerto por defecto es 8085.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8085
ENGINE_INTERNAL_URL=http://localhost:8085

# Origen por el que el Go Engine alcanza a este server de Next para descargar
# los clips. En local suele ser el propio origin; fíjalo si usas otro puerto.
WEB_INTERNAL_URL=http://localhost:3000
